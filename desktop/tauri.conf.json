{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APEX AI Trading Lab",
  "version": "1.0.0",
  "identifier": "local.apex.tradinglab",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "APEX AI Trading Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000 https://api.mexc.com wss://wbs.mexc.com https://api.github.com https://github.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/aliazizdbab/apex-ai-trading-lab/releases/latest/download/latest.json"
      ]
    }
  }
}
