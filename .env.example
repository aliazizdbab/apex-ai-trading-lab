# Database (PostgreSQL in Docker; leave unset locally to use sqlite:///./apex_local.db)
DATABASE_URL=postgresql+psycopg://apex:apex_change_me@127.0.0.1:5432/apex_trading
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex_change_me
POSTGRES_DB=apex_trading

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# AES-256-GCM Master Key (base64-encoded 32-byte key; generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
MASTER_ENCRYPTION_KEY=

# Session & Security
SESSION_TTL_HOURS=24
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
